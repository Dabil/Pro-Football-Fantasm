// Instructions:
// 1) Go to SITUATIONS Section and determine the situation (A, B, or C)
// 2) Go to OFFENSE or DEFENSE section. Roll 10-D and cross reference with coaching philosophy and situation to determine play call. 
// 3) Go to PLAY section. Roll 20-D and cross reference with coaching philosophy and play call (run or pass)
// 4) Got to PLAYER section. Roll 20-D and cross reference with coaching philosophy and play call (run or pass)
// 5) Return to normal play procedure
// 6) When the circumstances warrant it, make adjustments to the dice rolls as indicated in the GAME PLAN Adjustments section.

// Defense Key:
// S: Short
// K: Run-Key (R)
// N: Run-No Key
// R: Read
// D: Dog
// B: Blitz
// M: Pass-Man
// Z: Pass-Zone

// Player Key:
// B1: Back with the most Rushing Attempts
// R1: Receiver with the most Receptions
// R2: Receiver with 2nd most Receptions

[SITUATIONS_BEGIN]
  [SITUATION_BEGIN]
    [SITUATION_KEY]A
    [DOWN_1_DISTANCE]>10
    [DOWN_2_DISTANCE]>7
    [DOWN_3_DISTANCE]>6
    [DOWN_4_DISTANCE]>5
    [SOURCE_ROW]3
  [SITUATION_END]
  [SITUATION_BEGIN]
    [SITUATION_KEY]B
    [DOWN_1_DISTANCE]10
    [DOWN_2_DISTANCE]4-7
    [DOWN_3_DISTANCE]3-6
    [DOWN_4_DISTANCE]2-5
    [SOURCE_ROW]4
  [SITUATION_END]
  [SITUATION_BEGIN]
    [SITUATION_KEY]C
    [DOWN_1_DISTANCE]<10
    [DOWN_2_DISTANCE]<4
    [DOWN_3_DISTANCE]<3
    [DOWN_4_DISTANCE]1
    [SOURCE_ROW]5
  [SITUATION_END]
[SITUATIONS_END]

